<!doctype html>
<html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>CEE281 · Signal Control Lab</title>
<style>
:root{--paper:#f3f2ed;--ink:#18302d;--muted:#65756f;--line:#d9dfd8;--green:#216b57;--orange:#cf793b}*{box-sizing:border-box}body{margin:0;background:var(--paper);color:var(--ink);font:14px system-ui,-apple-system,"Arial",sans-serif}.wrap{max-width:1320px;margin:auto;padding:30px}header{display:flex;justify-content:space-between;gap:20px;align-items:center}h1{font-size:32px;letter-spacing:-1px;margin:10px 0}.eyebrow{font-size:11px;font-weight:700;letter-spacing:2px;color:var(--green)}p{line-height:1.7;color:var(--muted)}.tag{border:1px solid var(--line);border-radius:24px;padding:9px 14px;white-space:nowrap}.toolbar{display:flex;align-items:center;flex-wrap:wrap;gap:12px;background:white;border:1px solid var(--line);border-radius:12px;padding:14px 18px;margin:20px 0}button,select{font:inherit;border:1px solid var(--line);border-radius:6px;padding:8px 12px;background:white;color:var(--ink)}button{cursor:pointer}button.primary{background:var(--green);color:white}input[type=range]{flex:1;min-width:140px;accent-color:var(--green)}.time{font-variant-numeric:tabular-nums;min-width:98px}.grid{display:grid;grid-template-columns:1fr 1fr;gap:18px}.panel{background:white;border:1px solid var(--line);border-radius:12px;overflow:hidden;margin-bottom:18px;min-width:0}.head{flex-wrap:wrap;padding:18px 20px 10px;display:flex;justify-content:space-between;align-items:center;gap:10px}h2{font-size:16px;margin:0}.pill{font-size:12px;padding:5px 9px;border-radius:5px;background:#eaf4ee;color:var(--green)}canvas{width:100%;display:block}.intersection{height:310px;background:#142c2d}.chart{height:220px}.timeline{height:135px}.stats{display:grid;grid-template-columns:repeat(3,1fr);padding:14px 20px;gap:10px}.label{font-size:11px;color:var(--muted)}.number{font-size:23px;margin-top:4px}.note{padding:0 20px 16px;font-size:12px;color:var(--muted);line-height:1.7}.decision{padding:12px 20px;background:#f7f9f6;min-height:72px;font-size:12px;line-height:1.8}.legend{font-size:12px;color:var(--muted)}table{width:100%;border-collapse:collapse;font-size:12px}th,td{padding:12px 16px;border-bottom:1px solid #edf0eb;text-align:right}th:first-child,td:first-child{text-align:left}.table-wrap{overflow:auto}footer{font-size:12px;color:var(--muted);line-height:1.8;margin:18px 0}.summary{padding:16px 20px;background:#eaf4ee;line-height:1.7}a{color:var(--green)}@media(max-width:800px){.wrap{padding:18px 12px}.grid{grid-template-columns:1fr}.tag{display:none}h1{font-size:26px}.stats{padding:12px}.number{font-size:20px}}
</style></head><body><main class="wrap">
<header><div><div class="eyebrow">CEE281 / SIGNAL CONTROL LAB</div><h1>Same arrivals. Different signal strategies.</h1><p>Isolated intersection · Finite storage · Observation-driven control<br>Compare fixed-time and queue-responsive control under changing demand and detector faults.</p></div><span class="tag">Numerical simulation · Offline replay</span></header>
<div class="toolbar"><label for="scenario">Scenario</label><select id="scenario"></select><label for="candidate">Compare</label><select id="candidate"><option value="adaptive">Queue-responsive</option><option value="adaptive_no_hysteresis">Ablation: zero switching threshold</option></select><button id="play" class="primary">Play</button><button id="reset">Reset</button><input id="scrub" type="range" min="0" step="1" value="300" aria-label="Replay time"><span id="time" class="time"></span><select id="speed" aria-label="Playback speed"><option value="1">1×</option><option value="5">5×</option><option value="15" selected>15×</option><option value="60">60×</option></select><button id="event">Jump to event</button></div>
<div class="grid"><section class="panel"><div class="head"><h2>Fixed-time</h2><span id="fixed-phase" class="pill"></span></div><canvas id="fixed-road" class="intersection" aria-label="Fixed-time intersection queue schematic"></canvas><div class="stats"><div><div class="label">Road / external queue now</div><div class="number" id="fixed-q"></div></div><div><div class="label">Departures so far</div><div class="number" id="fixed-exits"></div></div><div><div class="label">Full-run delay · veh·min</div><div class="number" id="fixed-delay"></div></div></div><div class="decision" id="fixed-decision"></div></section>
<section class="panel"><div class="head"><h2 id="candidate-title">Queue-responsive control</h2><span id="candidate-phase" class="pill"></span></div><canvas id="candidate-road" class="intersection" aria-label="Responsive-control intersection queue schematic"></canvas><div class="stats"><div><div class="label">Road / external queue now</div><div class="number" id="candidate-q"></div></div><div><div class="label">Departures so far</div><div class="number" id="candidate-exits"></div></div><div><div class="label">Full-run delay · veh·min</div><div class="number" id="candidate-delay"></div></div></div><div class="decision" id="candidate-decision"></div></section></div>
<section class="panel"><div class="summary" id="summary"></div><div class="note" style="padding-top:12px">Blocks represent queued vehicles, with at most 10 drawn per approach; they are not spatial trajectories. No stop-line service occurs during yellow or all-red. Truth is used for replay and evaluation; control reads estimates. External queues contribute to delay but are not directly visible to the controller.</div></section>
<section class="panel"><div class="head"><h2>Signal phase timeline</h2><span class="legend">Green: N–S · Blue: E–W · Amber: yellow · Gray: all-red</span></div><canvas id="timeline" class="timeline"></canvas></section>
<div class="grid"><section class="panel"><div class="head"><h2>Total waiting vehicles · Including external queues</h2><span class="legend">Dark green: fixed · Orange: responsive</span></div><canvas id="queues" class="chart"></canvas><div class="note">Identical arrivals, initially empty queues, and analysis duration. The vertical line marks replay time.</div></section><section class="panel"><div class="head"><h2>Queue truth vs. estimate</h2><select id="approach" aria-label="Approach to compare"><option>N</option><option>S</option><option>E</option><option>W</option></select></div><canvas id="estimate" class="chart"></canvas><div class="note">Responsive control: dark green is the actual road queue; dashed orange is its estimate. Missing or stale observations trigger fixed-time fallback.</div></section></div>
<section class="panel"><div class="head"><h2>Paired experiments across seeds</h2><span class="legend">Positive saving = less delay than fixed-time control</span></div><div class="table-wrap"><table><thead><tr><th>Scenario / controller</th><th>Mean delay<br>veh·min</th><th>Mean departures<br>veh</th><th>External residual<br>veh</th><th>Paired saving<br>veh·min</th></tr></thead><tbody id="comparison"></tbody></table></div></section>
<footer id="footer"></footer></main>
<script>
const DATA=__SIGNAL_DATA__;
const $=id=>document.getElementById(id), colors={NS:'#49bc98',EW:'#79afe0',yellow:'#edbd67',all_red:'#738080'};
const labels={fixed:'Fixed-time',adaptive:'Queue-responsive',adaptive_no_hysteresis:'Zero threshold'};
const reasons={minimum_green:'Minimum green in progress',hold_green:'Hold current green',fixed_plan:'Follow fixed-time plan',fallback_fixed:'Observation fault: fixed-time fallback',maximum_green:'Maximum green reached',opposing_queue_larger:'Opposing estimated queue is larger',current_queue_empty:'Current estimated queue is empty',yellow_complete:'Yellow complete: enter all-red',clearance_complete:'Clearance complete: start next green',clearance_in_progress:'Clearance in progress'};
const phaseName=p=>{let [g,...s]=p.split('_');return (g==='NS'?'N–S':'E–W')+' · '+({green:'Green',yellow:'Yellow',all_red:'All-red'}[s.join('_')]);};
let time=Math.min(300,DATA.config.duration_s),playing=false,last=0;
for(const [key,s] of Object.entries(DATA.scenarios)){const o=document.createElement('option');o.value=key;o.textContent=s.label;$('scenario').appendChild(o);}
if(DATA.scenarios.directional_shift)$('scenario').value='directional_shift';
$('scrub').max=DATA.config.duration_s;
function run(mode){return DATA.runs[$('scenario').value+'/'+mode];}
function frame(r){return r.frames[Math.min(r.frames.length-1,Math.floor(time/DATA.config.frame_interval_s))];}
function setup(id){const el=$(id),rect=el.getBoundingClientRect(),dpr=window.devicePixelRatio||1;el.width=rect.width*dpr;el.height=rect.height*dpr;const c=el.getContext('2d');c.scale(dpr,dpr);return [c,rect.width,rect.height];}
function road(id,f){const [c,w,h]=setup(id),cx=w/2,cy=h/2;c.fillStyle='#142c2d';c.fillRect(0,0,w,h);c.fillStyle='#254346';c.fillRect(cx-48,0,96,h);c.fillRect(0,cy-48,w,96);c.strokeStyle='#6a8581';c.setLineDash([8,8]);c.beginPath();c.moveTo(cx,0);c.lineTo(cx,cy-48);c.moveTo(cx,cy+48);c.lineTo(cx,h);c.moveTo(0,cy);c.lineTo(cx-48,cy);c.moveTo(cx+48,cy);c.lineTo(w,cy);c.stroke();c.setLineDash([]);
const [group,...ss]=f.phase.split('_'),stage=ss.join('_');
for(const [a,rot] of [['N',0],['E',Math.PI/2],['S',Math.PI],['W',-Math.PI/2]]){c.save();c.translate(cx,cy);c.rotate(rot);c.strokeStyle='#dbe7df';c.lineWidth=2;c.beginPath();c.moveTo(-45,-51);c.lineTo(-3,-51);c.stroke();const active=(group==='NS'?'NS':'EW').includes(a);c.fillStyle=active&&stage==='green'?colors.NS:active&&stage==='yellow'?colors.yellow:'#da6d67';c.beginPath();c.arc(-58,-57,6,0,Math.PI*2);c.fill();for(let i=0;i<Math.min(10,f.queues[a]);i++){c.fillStyle=active&&stage==='green'?'#6dc4a4':'#c8d8d2';c.fillRect(-34,-67-i*8,18,6);}c.restore();}
c.font='12px system-ui';c.textAlign='left';c.fillStyle='#dcebe4';c.fillText('N  Queue '+f.queues.N+' / External '+f.external.N,15,23);c.fillText('W  Queue '+f.queues.W+' / External '+f.external.W,15,h-20);c.textAlign='right';c.fillText('E  Queue '+f.queues.E+' / External '+f.external.E,w-15,23);c.fillText('S  Queue '+f.queues.S+' / External '+f.external.S,w-15,h-20);c.textAlign='center';c.font='bold 14px system-ui';c.fillText(stage==='green'?(group==='NS'?'↕':'↔'):stage==='yellow'?'Yellow':'All-red',cx,cy+5);}
function plot(id,series){const [c,w,h]=setup(id),l=48,r=w-16,top=25,b=h-30,max=Math.max(5,...series.flatMap(s=>s.values.map(p=>p[1])))*1.1,x=t=>l+t/DATA.config.duration_s*(r-l),y=v=>b-v/max*(b-top);c.font='10px system-ui';for(let i=0;i<=4;i++){let yy=y(max*i/4);c.strokeStyle='#e6ece6';c.beginPath();c.moveTo(l,yy);c.lineTo(r,yy);c.stroke();c.fillStyle='#68796f';c.textAlign='right';c.fillText((max*i/4).toFixed(0),l-7,yy+3);}for(let i=0;i<=5;i++){let t=DATA.config.duration_s*i/5;c.textAlign='center';c.fillText(t.toFixed(0),x(t),b+16);}c.textAlign='left';c.fillText('Vehicles (veh)',l,13);c.fillText('Time (s)',r-38,h-2);for(const s of series){c.strokeStyle=s.color;c.lineWidth=1.8;c.setLineDash(s.dash?[5,4]:[]);c.beginPath();s.values.forEach(([t,v],i)=>i?c.lineTo(x(t),y(v)):c.moveTo(x(t),y(v)));c.stroke();}c.setLineDash([3,3]);c.strokeStyle='#899b91';c.beginPath();c.moveTo(x(time),top);c.lineTo(x(time),b);c.stroke();c.setLineDash([]);}
function timeline(a,b){const [c,w,h]=setup('timeline'),l=104,r=w-20,x=t=>l+t/DATA.config.duration_s*(r-l);c.font='11px system-ui';for(const [run,row] of [[a,0],[b,1]]){let yy=22+row*39;c.fillStyle='#53685d';c.fillText(row?'Responsive':'Fixed',20,yy+16);for(let i=0;i<run.frames.length-1;i++){let f=run.frames[i],[g,...ss]=f.phase.split('_'),s=ss.join('_');c.fillStyle=s==='green'?colors[g]:colors[s];c.fillRect(x(f.time_s),yy,Math.max(1,x(run.frames[i+1].time_s)-x(f.time_s)),23);}}c.strokeStyle='#173b2e';c.beginPath();c.moveTo(x(time),12);c.lineTo(x(time),95);c.stroke();c.fillStyle='#65756f';c.fillText('0 s',l,117);c.fillText(DATA.config.duration_s+' s',r-35,117);}
function render(){const fixed=run('fixed'),candidate=run($('candidate').value);$('scrub').value=time;$('time').textContent=Math.floor(time)+' / '+DATA.config.duration_s+' s';$('candidate-title').textContent=labels[$('candidate').value];for(const [id,r] of [['fixed',fixed],['candidate',candidate]]){const f=frame(r);road(id+'-road',f);$(id+'-phase').textContent=phaseName(f.phase);$(id+'-q').textContent=Object.values(f.queues).reduce((a,b)=>a+b,0)+' / '+Object.values(f.external).reduce((a,b)=>a+b,0);$(id+'-exits').textContent=f.exited_vehicles;$(id+'-delay').textContent=(r.metrics.total_delay_vehicle_s/60).toFixed(1);const log=r.control_log.filter(v=>v.issue_time_s<=f.time_s).at(-1);$(id+'-decision').textContent=(reasons[log.reason]||log.reason)+'. Estimated queues: N–S '+log.ns_estimated_queue_veh+' veh; E–W '+log.ew_estimated_queue_veh+' veh. '+(f.fallback?'Fallback is active. ':'')+' Data quality: '+Object.entries(f.quality).map(([a,q])=>a+' '+q).join(' / ');}
let saving=fixed.metrics.total_delay_vehicle_s-candidate.metrics.total_delay_vehicle_s,pct=fixed.metrics.total_delay_vehicle_s?saving/fixed.metrics.total_delay_vehicle_s*100:0;$('summary').textContent='Replay seed '+DATA.seed+' · Full-run delay versus fixed-time: '+(saving>=0?'reduced by ':'increased by ')+Math.abs(pct).toFixed(1)+'% ('+Math.abs(saving/60).toFixed(1)+' veh·min). Responsive-control residual: road queue '+candidate.metrics.residual_queue_veh+' veh; external queue '+candidate.metrics.residual_external_veh+' veh. ';
const sum=f=>Object.values(f.queues).reduce((a,b)=>a+b,0)+Object.values(f.external).reduce((a,b)=>a+b,0);plot('queues',[{values:fixed.frames.map(f=>[f.time_s,sum(f)]),color:'#216b57'},{values:candidate.frames.map(f=>[f.time_s,sum(f)]),color:'#cf793b'}]);const approach=$('approach').value;plot('estimate',[{values:candidate.frames.map(f=>[f.time_s,f.queues[approach]]),color:'#216b57'},{values:candidate.frames.map(f=>[f.time_s,f.estimates[approach]]),color:'#cf793b',dash:true}]);timeline(fixed,candidate);}
for(const row of DATA.summary){const tr=document.createElement('tr');for(const value of [DATA.scenarios[row.scenario].label+' / '+labels[row.controller],(row.mean_total_delay_vehicle_s/60).toFixed(1),row.mean_exited_vehicles.toFixed(1),row.mean_residual_external_veh.toFixed(1),(row.mean_paired_delay_saving_vehicle_s/60).toFixed(1)]){const td=document.createElement('td');td.textContent=value;tr.appendChild(td);}$('comparison').appendChild(tr);}
$('footer').textContent='Project-built intersection prototype; not yet integrated with the course scaffold. One through lane per approach; no turns, pedestrians, spatial spillback, or collision model. Parameters are uncalibrated. Forecasts are advisory and do not drive control. The table summarizes '+DATA.summary[0].seeds+' seeds; this is not a statistical significance claim.';
$('scenario').onchange=render;$('candidate').onchange=render;$('approach').onchange=render;$('scrub').oninput=()=>{time=+$('scrub').value;render();};$('reset').onclick=()=>{time=0;playing=false;$('play').textContent='Play';render();};$('play').onclick=()=>{playing=!playing;if(time>=DATA.config.duration_s)time=0;$('play').textContent=playing?'Pause':'Play';last=0;};$('event').onclick=()=>{const s=DATA.scenarios[$('scenario').value];time=s.faults?.[0]?.start_s||s.demand[1]?.start_s||0;render();};window.addEventListener('resize',render);function tick(now){if(playing&&last){time=Math.min(DATA.config.duration_s,time+(now-last)/1000*+$('speed').value);render();if(time>=DATA.config.duration_s){playing=false;$('play').textContent='Play';}}last=now;requestAnimationFrame(tick);}render();requestAnimationFrame(tick);
</script></body></html>
