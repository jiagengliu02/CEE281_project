<!doctype html>
<html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>CEE281 · Traffic Lab</title>
<style>
:root{--paper:#f3f2ed;--ink:#18302d;--muted:#677671;--line:#d9dfd8;--green:#216b57;--orange:#d98243;--white:#fff}*{box-sizing:border-box}body{margin:0;background:var(--paper);color:var(--ink);font:14px system-ui,-apple-system,"Arial",sans-serif}.wrap{max-width:1440px;margin:auto;padding:30px 36px 40px}.eyebrow{font-size:11px;font-weight:700;letter-spacing:2px;color:var(--green)}header{display:flex;align-items:flex-end;justify-content:space-between;gap:20px;margin-bottom:24px}h1{font-size:32px;font-weight:600;letter-spacing:-1px;margin:9px 0}header p{color:var(--muted);margin:0;line-height:1.7}.tag{border:1px solid var(--line);border-radius:30px;padding:9px 14px;font-size:12px;white-space:nowrap}.toolbar{display:flex;align-items:center;gap:12px;flex-wrap:wrap;padding:14px 18px;background:white;border:1px solid var(--line);border-radius:12px;margin-bottom:18px}button,select{font:inherit;border:1px solid var(--line);border-radius:6px;padding:8px 12px;background:white;color:var(--ink);cursor:pointer}button.primary{background:var(--green);border-color:var(--green);color:white}button:hover{filter:brightness(.94)}label{font-size:12px;color:var(--muted)}input[type=range]{flex:1;min-width:160px;accent-color:var(--green)}.time{font-variant-numeric:tabular-nums;width:116px;white-space:nowrap;font-weight:600}.cards{display:grid;grid-template-columns:repeat(4,1fr);gap:14px;margin-bottom:18px}.card{background:white;border:1px solid var(--line);padding:18px 20px;border-radius:10px}.card .label{font-size:12px;color:var(--muted)}.value{font-size:30px;font-weight:600;margin:6px 0}.unit{font-size:12px;color:var(--muted);font-weight:400}.sub{font-size:12px;color:var(--muted);line-height:1.6}.panel{background:white;border:1px solid var(--line);border-radius:12px;overflow:hidden;margin-bottom:18px}.panelhead{flex-wrap:wrap;padding:18px 20px 12px;display:flex;align-items:center;justify-content:space-between;gap:12px}.panelhead h2{font-size:16px;margin:0;font-weight:600}.legend{font-size:11px;color:var(--muted);display:flex;gap:15px;align-items:center;flex-wrap:wrap}.dot{display:inline-block;width:8px;height:8px;border-radius:50%;margin-right:5px}.road{background:#132a2b;padding:5px 12px 0}.road canvas{width:100%;height:295px;display:block}.roadfoot{flex-wrap:wrap;gap:8px;background:#132a2b;color:#b9d1c9;display:flex;justify-content:space-between;padding:0 25px 15px;font-size:12px}.grid{display:grid;grid-template-columns:1fr 1fr;gap:18px}.grid .panel{min-width:0}.plot{width:100%;height:260px;display:block}.plotpad{padding:0 12px 10px}.info{padding:0 20px 16px;font-size:12px;color:var(--muted);line-height:1.7}table{width:100%;border-collapse:collapse;font-size:13px}th,td{text-align:left;padding:12px 20px;border-bottom:1px solid #edf0eb}th{font-size:11px;color:var(--muted);font-weight:500}tr:last-child td{border-bottom:0}.notes{font-size:12px;color:var(--muted);line-height:1.8;margin-top:10px}.badge{color:var(--green);background:#eaf4ee;border-radius:4px;padding:3px 7px;font-size:11px}.small{font-size:11px}footer{padding-top:18px;border-top:1px solid var(--line);color:var(--muted);font-size:11px} @media(max-width:850px){.wrap{padding:20px 16px}.cards{grid-template-columns:repeat(2,1fr)}.grid{grid-template-columns:1fr}header{display:block}.tag{display:none}.legend{font-size:10px}.toolbar{gap:8px}h1{font-size:26px}.panelhead{align-items:flex-start}}
.tmc-cards .value{font-size:24px;overflow-wrap:anywhere}</style></head><body><div class="wrap">
<header><div><div class="eyebrow">CEE281 / NUMERICAL TRAFFIC LAB</div><h1>Freeway traffic, ramps, and work-zone queues</h1><p>Three-lane IDM · Ramp entry and work-zone merging · Detectors → Estimates → Forecasts → Ramp decisions → IDM execution</p></div><div class="tag">Teaching prototype · SI units</div></header>
<div class="toolbar"><label for="mode">Scenario</label><select id="mode"><option value="closure">Closure · Unmetered ramp</option><option value="open">Open road · Three lanes</option><option value="fixed">Closure · Fixed ramp metering</option><option value="adaptive" selected>Closure · Forecast-assisted metering</option><option value="adaptive_fault">Closure · Adaptive + detector faults</option></select><button class="primary" id="play">Play</button><button id="reset">Reset</button><button id="showMerge">Watch a merge</button><button id="showRamp">Watch ramp cars</button><input id="scrub" aria-label="Simulation time" type="range" min="0" max="600" step="1" value="180"><span class="time" id="time"></span><select id="rate" aria-label="Playback speed"><option value="1">1×</option><option value="2" selected>2×</option><option value="5">5×</option><option value="20">20×</option><option value="60">60×</option></select></div>
<div class="cards"><div class="card"><div class="label">Vehicles on road now</div><div class="value" id="n"></div><div class="sub">Exited <span id="exits"></span> veh</div></div><div class="card"><div class="label">Mainline / ramp queue</div><div class="value" id="waiting"></div><div class="sub">Waiting outside the road; included in delay</div></div><div class="card"><div class="label">Full-run throughput</div><div class="value" id="throughput"></div><div class="sub">Exits divided by the full analysis period</div></div><div class="card"><div class="label">Full-run total delay</div><div class="value" id="delay"></div><div class="sub">Includes entry waits and unfinished trips</div></div></div>
<section class="panel"><div class="panelhead"><h2>Vehicle replay</h2><div class="legend"><span><i class="dot" style="background:#46ba97"></i>Mainline vehicles</span><span><i class="dot" style="background:#edaa65"></i>Ramp vehicles</span><span><i class="dot" style="background:#7ebae6"></i>Yielding vehicles</span><span>Vehicle bar: speed / reference desired speed</span></div></div><div class="road"><canvas id="road"></canvas></div><div class="roadfoot"><span id="demand"></span><span id="roadqueue"></span></div><div class="info" style="padding-top:12px">Lane 0 is the left lane. Drivers seek gaps in advance of a gradual taper. Merge urgency and courtesy increase toward the usable lane end; vehicles stop before the remaining width becomes insufficient if no safe gap exists. Slowing emerges from following and merging. Watch a merge follows one work-zone merge at 1× speed. Blue vehicles are yielding. Lane changes are instantaneous in the model; lateral smoothing and placement within the taper are display-only. The ramp signal shows the sampled command: red = hold, green = permit subject to a safe gap, dark = unmetered. Orange vehicles drive along the ramp, follow the vehicle ahead, and wait near the merge point for permission and a safe mainline gap. The same vehicle continues onto the freeway after entry. Upstream counts represent vehicles waiting outside the drawn ramp. signal states are sampled every second.</div></section>
<section class="panel"><div class="panelhead"><h2>Ramp control · Five-stage decision trace</h2><span class="badge" id="tmcStatus"></span></div>
<div class="cards tmc-cards" style="padding:0 18px;grid-template-columns:repeat(auto-fit,minmax(150px,1fr))">
<div class="card"><div class="label">1 · DETECT</div><div class="value" id="sense"></div><div class="sub" id="senseDetail"></div></div>
<div class="card"><div class="label">2 · ESTIMATE</div><div class="value" id="estimate"></div><div class="sub">Road vehicles / ramp queue · veh</div></div>
<div class="card"><div class="label">3 · PREDICT</div><div class="value" id="forecast"></div><div class="sub">Expected ramp arrivals · forecast horizon · EMA</div></div>
<div class="card"><div class="label">4 · DECIDE</div><div class="value" id="interval"></div><div class="sub" id="decisionReason"></div></div>
<div class="card"><div class="label">5 · EXECUTE</div><div class="value" id="execution"></div><div class="sub" id="executionDetail"></div></div></div>
<div class="info" id="tmcExplanation"></div></section>
<div class="grid">
<section class="panel"><div class="panelhead"><h2>Road inventory · Truth vs. estimate</h2></div><canvas class="plot" id="roadEstimate"></canvas><div class="info">Green: true number of vehicles on the road. Orange: boundary-counter estimate held between reports. This measures inventory, not slow-vehicle queue length.</div></section>
<section class="panel"><div class="panelhead"><h2>Ramp queue · Truth vs. estimate</h2></div><canvas class="plot" id="rampEstimate"></canvas><div class="info">Green: true waiting count. Orange: arrivals minus successful ramp entries. Waiting vehicles use a FIFO point queue; after entry they follow IDM.</div></section>
<section class="panel"><div class="panelhead"><h2>30-second ramp arrival forecast</h2></div><canvas class="plot" id="forecastPlot"></canvas><div class="info" id="forecastScore"></div></section>
<section class="panel"><div class="panelhead"><h2>Commanded minimum release interval</h2></div><canvas class="plot" id="meterPlot"></canvas><div class="info">Green: commanded interval. Orange points: fixed fallback. A permit still waits for a safe merge gap. All waits remain in total delay.</div></section>
</div>
<div class="grid"><section class="panel"><div class="panelhead"><h2>Vehicle trajectories · Position vs. time</h2><select id="trajectoryLane" aria-label="Trajectory lane"><option value="0">Lane 0 · Left</option><option value="1">Lane 1 · Center</option><option value="2">Lane 2 · Right</option><option value="all">All lanes</option></select></div><div class="plotpad"><canvas class="plot" id="trajectory"></canvas></div><div class="info">Color indicates speed; shallower slopes mean slower vehicles. Lane-filtered trajectories break at lane changes. The vertical line marks replay time.</div></section><section class="panel"><div class="panelhead"><h2>Boundary waits and road queues</h2><div class="legend"><span><i class="dot" style="background:#216b57"></i>Mainline queue</span><span><i class="dot" style="background:#d98243"></i>Ramp queue</span><span><i class="dot" style="background:#7993b0"></i>Slow vehicles on road</span></div></div><div class="plotpad"><canvas class="plot" id="queues"></canvas></div><div class="info">Road queues count vehicles below the configured speed threshold. These are simulator truth values, not sensor estimates.</div></section><section class="panel"><div class="panelhead"><h2>Detector interval flow</h2><select id="detector" aria-label="Select detector"><option value="200">200 m · Before ramp</option><option value="550" selected>550 m · Before work zone</option><option value="900">900 m · After work zone</option></select></div><div class="plotpad"><canvas class="plot" id="flow"></canvas></div><div class="info">Crossings over 30 seconds are converted to veh/h. Reports become available after each complete interval. Charts show the full run.</div></section><section class="panel"><div class="panelhead"><h2>Detector mean speed</h2><select id="sensorLane" aria-label="Detector lane"><option value="all">All lanes combined</option><option value="0">Lane 0</option><option value="1">Lane 1</option><option value="2">Lane 2</option></select></div><div class="plotpad"><canvas class="plot" id="speed"></canvas></div><div class="info">Mean speed uses crossing vehicles only. Intervals without crossings remain missing rather than being reported as zero speed.</div></section></div>
<section class="panel"><div class="panelhead"><h2>Full-run comparison under identical demand</h2><span class="badge" id="checks"></span></div><div style="overflow:auto"><table><thead><tr><th>Metric</th><th>Open road</th><th>Lane closure</th><th>Closure + fixed metering</th><th>Closure + adaptive</th><th>Adaptive + sensor faults</th></tr></thead><tbody id="comparison"></tbody></table></div><div class="info" style="padding-top:12px">Compare open-road and closure cases first, then compare unmetered and fixed-metered ramp entry under the same closure. All modes share arrivals and driver parameters. Adaptive uses measured boundary counters and 30-second EMA forecasts. The fault case loses reports at 300–360 s and delays reports at 420–480 s by 45 s. Gains and regressions both count; compare total delay including ramp waits.</div></section>
<div class="notes"><strong>Model scope: </strong>Three lanes, deterministic arrivals, desired speeds of 25–31 m/s, IDM following, and simplified MOBIL-inspired lane changes. Work-zone merges require acceptable front/rear gaps and braking. A simplified alternating-yield rule lets a following vehicle open a gap and then receive its turn. There is no continuous lateral dynamics or calibrated courtesy model. The lane-ending obstacle, rather than a speed zone, produces slowing. Delay uses each driver’s desired speed and includes boundary waits and unfinished trips. Charts use truth; detector CSV provides the observation interface. Default demand rises at 240 s and falls at 480 s. Timestep sensitivity is reported; these behavioral assumptions are not empirically calibrated.</div>
<footer>IDM: Treiber, Hennecke & Helbing (2000), Physical Review E 62, 1805–1824.  · MOBIL: Kesting, Treiber & Helbing (2007). · Teaching prototype; not empirically calibrated.</footer>
</div><script>
const DATA=__SIMULATION_DATA__;
const $=id=>document.getElementById(id),cfg=DATA.config;let mode='adaptive',index=Math.min(60,DATA.runs.adaptive.frames.length-1),playing=false,last=0,accumulator=0,trackedId=null,trackUntil=null,lastPlotIndex=-1;const endIndex=DATA.runs.closure.frames.length-1;$('scrub').max=endIndex;$('mode').options[2].textContent='Closure · Fixed release every '+cfg.ramp_release_interval_s+' s';
function setup(id){const c=$(id),r=c.getBoundingClientRect(),dpr=window.devicePixelRatio||1;c.width=r.width*dpr;c.height=r.height*dpr;const ctx=c.getContext('2d');ctx.scale(dpr,dpr);return [ctx,r.width,r.height];}
function rampSignal(frame){
 const command=frame.control;
 if(mode==='open'||mode==='closure')return {color:null,label:'OFF · Unmetered',detail:'Enter when a safe gap is available'};
 if(!command)return {color:null,label:'Waiting for command',detail:'No control sample yet'};
 const permit=command.action==='permit', last=command.last_release_s;
 const wait=last===null?0:Math.max(0,command.value-(command.issue_time_s-last));
 return {color:permit?'#46e39a':'#ff665e',label:permit?'GREEN · Permit':'RED · Hold',
  detail:(permit?'Waiting for safe gap / demand':'Next permit in '+wait.toFixed(1)+' s')+(command.fallback?' · Fixed fallback':''),
  recent:last!==null&&frame.time>=last&&frame.time-last<1,
  last};
}
function drawRampSignal(c,x,ry,frame){
 const signal=rampSignal(frame),sx=x(cfg.merge_position_m)+12,sy=ry+80;
 c.save();c.fillStyle='#091b1c';c.fillRect(sx-8,sy-8,16,32);
 for(const [dy,color,on] of [[0,'#ff665e',signal.color==='#ff665e'],[16,'#46e39a',signal.color==='#46e39a']]){
  c.beginPath();c.arc(sx,sy+dy,5,0,Math.PI*2);c.fillStyle=on?color:'#263a39';c.fill();
 }
 c.font='10px system-ui';c.fillStyle=signal.color||'#b9d1c9';c.fillText(signal.label,sx+15,sy+4);
 c.fillStyle='#b9d1c9';c.fillText(signal.detail,sx+15,sy+20);c.restore();
}
let rampCurveCache=null;
function rampPose(s,x,ry){
 const ax=x(50),bx=x(cfg.merge_position_m-65),dx=x(cfg.merge_position_m);
 const point=t=>{const u=1-t;return {x:u*u*u*ax+3*u*t*bx+t*t*t*dx,y:ry+43+33*(u*u*u+3*u*u*t)};};
 const key=[ax,bx,dx,ry].join(',');
 if(!rampCurveCache||rampCurveCache.key!==key){
  const samples=[{t:0,d:0}],count=120;let prev=point(0),distance=0;
  for(let i=1;i<=count;i++){const p=point(i/count);distance+=Math.hypot((p.x-prev.x)/(x(1)-x(0)),(p.y-prev.y)/(43/(cfg.lane_width_m||3.6)));samples.push({t:i/count,d:distance});prev=p;}
  rampCurveCache={key,samples,total:distance};
 }
 const {samples,total}=rampCurveCache,target=Math.max(0,Math.min(1,s/(cfg.ramp_length_m||200)))*total;
 let hi=samples.findIndex(p=>p.d>=target);if(hi<1)hi=1;
 const a=samples[hi-1],b=samples[hi],t=a.t+(b.t-a.t)*(target-a.d)/(b.d-a.d),u=1-t;
 const p=point(t),vx=3*u*u*(bx-ax)+3*t*t*(dx-bx),vy=-198*u*t;
 return {...p,angle:Math.atan2(vy,vx)};
}
function drawRampCars(c,x,ry,frame,scale,halfH){
 for(const car of frame.ramp_vehicles||[]){
  const p=rampPose(car[1],x,ry),rear=rampPose(Math.max(0,car[1]-5),x,ry);
  // Project the vehicle footprint using the road's separate longitudinal and
  // lateral scales; rotating a tall screen rectangle exaggerates its width.
  const lateralScale=43/(cfg.lane_width_m||3.6),dx=(p.x-rear.x)/scale,dy=(p.y-rear.y)/lateralScale;
  const length=Math.hypot(dx,dy)||1,halfWidth=(cfg.vehicle_width_m||1.8)/2;
  const ox=-dy/length*halfWidth*scale,oy=(dx===0&&dy===0?1:dx)/length*halfWidth*lateralScale;
  if(car[1]<5){rear.x=p.x-5*scale;rear.y=p.y;}
  c.fillStyle='#edaa65';c.beginPath();c.moveTo(p.x+ox,p.y+oy);c.lineTo(p.x-ox,p.y-oy);c.lineTo(rear.x-ox,rear.y-oy);c.lineTo(rear.x+ox,rear.y+oy);c.closePath();c.fill();
  c.strokeStyle='#132a2b';c.lineWidth=2;c.beginPath();c.moveTo(rear.x,rear.y);
  const speedRatio=Math.min(1,Math.max(0,car[2]/cfg.desired_speed_mps));c.lineTo(rear.x+(p.x-rear.x)*speedRatio,rear.y+(p.y-rear.y)*speedRatio);c.stroke();
 }
 c.fillStyle='#edbc82';c.font='11px system-ui';
 c.fillText('Ramp vehicles '+frame.ramp_queue+' · upstream '+(frame.ramp_upstream||0),x(55),ry+116);
}
function replayFrame(run,value){
 const lo=Math.floor(value),hi=Math.min(run.frames.length-1,lo+1),blend=value-lo;
 const base=run.frames[lo],next=run.frames[hi],time=base.time+(next.time-base.time)*blend;
 const following=new Map(next.vehicles.map(v=>[v[0],v]));
 const frame={...base,time,vehicles:base.vehicles.map(car=>{
  const n=following.get(car[0]);if(!n)return car;const v=[...car];
  v[1]+=blend*(n[1]-v[1]);v[2]+=blend*(n[2]-v[2]);
  if(n[6]<=time){v[4]=n[4];v[5]=n[5];v[6]=n[6];}return v;
 }),ramp_vehicles:[]};
 const rampNext=new Map((next.ramp_vehicles||[]).map(v=>[v[0],v]));
 const rampBase=new Set((base.ramp_vehicles||[]).map(v=>v[0]));
 let admissions=0;
 for(const car of base.ramp_vehicles||[]){
  const n=rampNext.get(car[0]);
  if(n){const v=[...car];v[1]+=blend*(n[1]-v[1]);v[2]+=blend*(n[2]-v[2]);frame.ramp_vehicles.push(v);continue;}
  const road=following.get(car[0]);
  if(!road){frame.ramp_vehicles.push(car);continue;}
  const entry=road[8];
  if(time<entry){
   const u=(time-base.time)/Math.max(1e-9,entry-base.time);
   frame.ramp_vehicles.push([car[0],car[1]+u*((cfg.ramp_length_m||200)-car[1]),car[2],car[3]]);
  }else{
   const u=Math.min(1,Math.max(0,(time-entry)/Math.max(1e-9,next.time-entry))),v=[...road];
   v[1]=cfg.merge_position_m+u*(road[1]-cfg.merge_position_m);v[2]=road[9]+u*(road[2]-road[9]);
   v[4]=cfg.lanes-1;v[5]=cfg.lanes-1;frame.vehicles.push(v);
  }
 }
 for(const car of next.ramp_vehicles||[]){
  if(rampBase.has(car[0])||time<car[3])continue;
  const u=Math.min(1,Math.max(0,(time-car[3])/Math.max(1e-9,next.time-car[3])));
  frame.ramp_vehicles.push([car[0],car[1]*u,car[2]*u,car[3]]);admissions++;
 }
 frame.ramp_upstream=Math.max(0,(base.ramp_upstream||0)-admissions);
 frame.ramp_queue=frame.ramp_vehicles.length+frame.ramp_upstream;
 return frame;
}
function drawRoad(frame){const [c,w,h]=setup('road'),left=40,right=w-35,scale=(right-left)/cfg.road_length_m,x=p=>left+p*scale,top=58,laneH=43,y=l=>top+laneH*(l+.5);c.fillStyle='#132a2b';c.fillRect(0,0,w,h);c.fillStyle='#244243';c.fillRect(left,top,right-left,laneH*cfg.lanes);c.font='11px system-ui';c.fillStyle='#aec8be';for(let p=0;p<=cfg.road_length_m;p+=100)c.fillText(p+' m',x(p)-12,32);c.strokeStyle='#6b8780';c.lineWidth=1;c.setLineDash([8,8]);for(let l=1;l<cfg.lanes;l++){c.beginPath();c.moveTo(left,top+laneH*l);c.lineTo(right,top+laneH*l);c.stroke();}c.setLineDash([]);
if(mode!=='open'){const ts=cfg.taper_start_m??cfg.closure_start_m,cs=x(cfg.closure_start_m),ce=x(cfg.closure_end_m),yy=top+cfg.closed_lane*laneH;c.save();c.beginPath();c.moveTo(x(ts),yy);c.lineTo(ce,yy);c.lineTo(ce,yy+laneH);c.lineTo(cs,yy+laneH);c.closePath();c.fillStyle='#5b4634';c.fill();c.clip();c.strokeStyle='#b88851';c.lineWidth=4;for(let px=x(ts)-laneH;px<ce;px+=17){c.beginPath();c.moveTo(px,yy+laneH);c.lineTo(px+laneH,yy);c.stroke();}c.restore();c.fillStyle='#eebd80';c.fillText('WORK ZONE · CLOSED',cs+8,top-9);for(let p=ts;p<=cfg.closure_end_m;p+=10){const px=x(p),cy=yy+laneH*Math.min(1,(p-ts)/Math.max(1,cfg.closure_start_m-ts));c.fillStyle='#edaa65';c.beginPath();c.moveTo(px,cy-3);c.lineTo(px-3,cy+3);c.lineTo(px+3,cy+3);c.fill();}c.fillStyle='#edbc82';c.fillText('Merge ahead →',x(cfg.merge_anticipation_m),top-9);c.fillText('Taper',x(ts),top+laneH+15);}

for(let l=0;l<cfg.lanes;l++){c.fillStyle='#b9d1c9';c.fillText('L'+l+(l===0?' Left lane':''),left+8,y(l)+4);}for(const p of cfg.detectors_m){c.strokeStyle='#9ce5d1';c.lineWidth=1;c.beginPath();c.moveTo(x(p),top-3);c.lineTo(x(p),top+laneH*cfg.lanes+3);c.stroke();c.fillStyle='#9ce5d1';c.fillText('D '+p,x(p)-15,top+laneH*cfg.lanes+18);}
const ry=y(cfg.lanes-1),rampHalfH=cfg.vehicle_width_m?laneH*cfg.vehicle_width_m/cfg.lane_width_m/2:7;
c.lineWidth=2*rampHalfH+8;c.strokeStyle='#244243';c.beginPath();c.moveTo(x(50),ry+76);c.bezierCurveTo(x(cfg.merge_position_m-65),ry+76,x(cfg.merge_position_m-65),ry+43,x(cfg.merge_position_m),ry+43);c.stroke();
c.beginPath();c.moveTo(x(cfg.merge_position_m),ry+43);c.bezierCurveTo(x(cfg.merge_position_m+15),ry+43,x(cfg.merge_position_m+30),ry,x(cfg.merge_position_m+45),ry);c.stroke();
c.fillStyle='#b9d1c9';c.fillText('Mainline queue '+frame.main_queue,x(550),ry+116);
drawRampSignal(c,x,ry,frame);drawRampCars(c,x,ry,frame,scale,rampHalfH);
for(const car of frame.vehicles){const px=x(car[1]),cw=5*scale,halfH=cfg.vehicle_width_m?laneH*cfg.vehicle_width_m/cfg.lane_width_m/2:7;const from=car[5]>=0?car[5]:car[4],u=Math.min(1,Math.max(0,(frame.time-car[6])/1.5));let py=y(from)+(y(car[4])-y(from))*u;
if(car[3]==='ramp'&&frame.time>=car[8]&&car[1]<cfg.merge_position_m+45){const progress=Math.max(0,Math.min(1,(car[1]-cfg.merge_position_m)/45));py+=43*(1-progress*progress*(3-2*progress));}
// Fit the display footprint into the remaining corridor; this is not lateral physics.
if(mode!=='open'&&cfg.taper_start_m!==undefined&&car[1]>=cfg.taper_start_m&&car[1]<cfg.closure_end_m+5){const boundary=top+laneH*Math.min(1,(car[1]-cfg.taper_start_m)/(cfg.closure_start_m-cfg.taper_start_m)),margin=laneH*cfg.taper_clearance_m/cfg.lane_width_m; if(car[4]===cfg.closed_lane)py=(boundary+top+laneH)/2;else py=Math.max(py,boundary+halfH+margin);}
if(car[0]===trackedId){c.strokeStyle='#ffe18b';c.lineWidth=2;c.strokeRect(px-cw-3,py-11,cw+6,22);c.fillStyle='#ffe18b';c.fillText('Tracking vehicle #'+car[0],px+8,py-12);if(car[4]!==from&&frame.time-car[6]<3){c.setLineDash([3,3]);c.beginPath();c.moveTo(px,y(from));c.lineTo(px,y(car[4]));c.stroke();c.setLineDash([]);}}c.fillStyle=car[7]?'#7ebae6':car[3]==='ramp'?'#edaa65':'#46ba97';c.fillRect(px-cw,py-halfH,cw,2*halfH);c.fillStyle='#132a2b';c.fillRect(px-cw+1,py-1,Math.min(cw-2,Math.max(0,(cw-2)*car[2]/cfg.desired_speed_mps)),3);}}
function axes(id,ymax,ylabel){const [c,w,h]=setup(id),box={l:57,r:w-17,t:24,b:h-35};c.fillStyle='white';c.fillRect(0,0,w,h);c.font='10px system-ui';c.lineWidth=1;for(let j=0;j<=4;j++){let yy=box.b-(box.b-box.t)*j/4;c.strokeStyle='#e8ede7';c.beginPath();c.moveTo(box.l,yy);c.lineTo(box.r,yy);c.stroke();c.fillStyle='#6b7a72';c.textAlign='right';c.fillText((ymax*j/4).toFixed(ymax<50?1:0),box.l-8,yy+4);}for(let t=0;t<=cfg.duration_s;t+=cfg.duration_s/5){let xx=box.l+(box.r-box.l)*t/cfg.duration_s;c.textAlign='center';c.fillText(t,xx,box.b+17);}c.textAlign='left';c.fillStyle='#6b7a72';c.fillText(ylabel,box.l,12);c.fillText('Time (s)',box.r-40,h-4);return {c,w,h,box,x:t=>box.l+(box.r-box.l)*t/cfg.duration_s,y:v=>box.b-(box.b-box.t)*v/ymax};}
function line(a,points,color){const {c,x,y}=a;c.strokeStyle=color;c.lineWidth=1.7;c.beginPath();let pen=false;for(const [t,v] of points){if(v===null||v===undefined){pen=false;continue;}if(pen)c.lineTo(x(t),y(v));else c.moveTo(x(t),y(v));pen=true;}c.stroke();}
function cursor(a){a.c.strokeStyle='#96aaa2';a.c.lineWidth=1;a.c.setLineDash([3,3]);a.c.beginPath();a.c.moveTo(a.x(DATA.runs[mode].frames[Math.floor(index)].time),a.box.t);a.c.lineTo(a.x(DATA.runs[mode].frames[Math.floor(index)].time),a.box.b);a.c.stroke();a.c.setLineDash([]);}
function drawPlots(){drawTmcPlots();const run=DATA.runs[mode],frames=run.frames;let a=axes('trajectory',cfg.road_length_m,'Position (m)');const prev=new Map(),selected=$('trajectoryLane').value;for(const f of frames){for(const car of f.vehicles){const old=prev.get(car[0]);if(old&&f.time-old[0]<=cfg.frame_interval_s*1.1&&(selected==='all'||String(car[4])===selected&&String(old[2])===selected)){a.c.strokeStyle=`hsl(${15+135*Math.min(1,car[2]/cfg.desired_speed_mps)},52%,47%)`;a.c.lineWidth=.7;a.c.beginPath();a.c.moveTo(a.x(old[0]),a.y(old[1]));a.c.lineTo(a.x(f.time),a.y(car[1]));a.c.stroke();}prev.set(car[0],[f.time,car[1],car[4]]);}}cursor(a);
let maxQ=Math.max(10,...frames.flatMap(f=>[f.main_queue,f.ramp_queue,f.road_queue]));a=axes('queues',Math.ceil(maxQ/10)*10,'Vehicles (veh)');for(const [key,color] of [['main_queue','#216b57'],['ramp_queue','#d98243'],['road_queue','#7993b0']])line(a,frames.map(f=>[f.time,f[key]]),color);cursor(a);
const obs=run.observations.filter(o=>String(o.position_m)===$('detector').value&&($('sensorLane').value==='all'||String(o.lane_id)===$('sensorLane').value));const groups=new Map();for(const o of obs){let g=groups.get(o.interval_end_s)||{count:0,sum:0};g.count+=o.count;if(o.mean_speed_mps!==null)g.sum+=o.mean_speed_mps*o.count;groups.set(o.interval_end_s,g);}const points=[...groups.entries()];let maxFlow=Math.max(2400,...points.map(([t,g])=>g.count*3600/cfg.detector_interval_s));a=axes('flow',Math.ceil(maxFlow/400)*400,'Flow (veh/h)');line(a,points.map(([t,g])=>[t,g.count*3600/cfg.detector_interval_s]),'#216b57');cursor(a);a=axes('speed',cfg.desired_speed_mps+cfg.speed_variation_mps+1,'Speed (m/s)');line(a,points.map(([t,g])=>[t,g.count?g.sum/g.count:null]),'#d98243');cursor(a);}
function update(forcePlots=true){const run=DATA.runs[mode];index=Math.min(endIndex,Math.max(0,index));const lo=Math.floor(index),base=run.frames[lo],frame=replayFrame(run,index);$('scrub').value=lo;$('time').textContent=frame.time.toFixed(1)+' / '+cfg.duration_s+' s';$('n').textContent=frame.vehicles.length;$('exits').textContent=frame.exits;$('waiting').innerHTML=frame.main_queue+' / '+frame.ramp_queue+' <span class="unit">veh</span>';$('throughput').innerHTML=Math.round(run.metrics.throughput_vph)+' <span class="unit">veh/h</span>';$('delay').innerHTML=(run.metrics.total_delay_vehicle_s/60).toFixed(1)+' <span class="unit">veh·min</span>';let demand=cfg.demand[0];for(const d of cfg.demand)if(frame.time>=d.start_s)demand=d;$('demand').textContent='Demand: mainline '+demand.main_vph+' + ramp '+demand.ramp_vph+' veh/h';$('roadqueue').textContent='Slow vehicles '+frame.road_queue+' veh · Work-zone merges '+(base.mandatory_merges||0)+' events';drawRoad(frame);drawTrace(base);if(forcePlots||lo!==lastPlotIndex){drawPlots();lastPlotIndex=lo;}}
function table(){const metrics=['open','closure','fixed','adaptive','adaptive_fault'].map(k=>DATA.runs[k].metrics);const rows=[['Road estimate MAE','road_estimate_mae_veh','veh',v=>v===null?'—':v.toFixed(2)],['Ramp estimate MAE','ramp_estimate_mae_veh','veh',v=>v===null?'—':v.toFixed(2)],['Fallback duration','fallback_time_s','s'],['Generated vehicles','generated_vehicles','veh'],['Exited vehicles','exited_vehicles','veh'],['Total delay','total_delay_vehicle_s','veh·min',v=>(v/60).toFixed(1)],['Peak slow-vehicle count','max_road_queue','veh'],['Vehicles remaining on road','remaining_on_road','veh'],['Residual mainline queue','remaining_main_queue','veh'],['Residual ramp queue','remaining_ramp_queue','veh'],['Lane changes','lane_changes','events'],['Mandatory work-zone merges','mandatory_merges','events'],['Minimum net gap','minimum_gap_m','m',v=>v===null?'—':v.toFixed(2)],['Closed-lane violations','closed_lane_violations','events'],['Numerical guard interventions','safety_interventions','events']];$('comparison').innerHTML=rows.map(([label,key,unit,fmt])=>'<tr><td>'+label+'</td>'+metrics.map(m=>'<td>'+(fmt?fmt(m[key]):m[key])+' '+unit+'</td>').join('')+'</tr>').join('');$('checks').textContent='Conservation ✓ · Closure violations '+metrics.reduce((s,m)=>s+m.closed_lane_violations,0)+' · Guard interventions '+metrics.reduce((s,m)=>s+m.safety_interventions,0);}

const numberOrDash=v=>v===null||v===undefined?'—':Number(v).toFixed(1);
function drawTrace(frame){
 const command=frame.control, estimate=frame.estimate;
 const obs=DATA.runs[mode].boundary_observations.filter(r=>r.sensor_id==='ramp_arrivals'&&r.available_time_s<=(command?.issue_time_s??0));
 const latest=obs.length?obs.reduce((a,b)=>a.interval_end_s>b.interval_end_s?a:b):null;
 $('tmcStatus').textContent=(command?.fallback?'FALLBACK · ':'')+estimate.quality_flag;
 $('sense').textContent=latest&&latest.count!==null?latest.count+' veh':'—';
 $('senseDetail').textContent=latest?'Ramp arrivals in report ending '+latest.interval_end_s+' s · '+latest.quality_flag:'Waiting for first completed report';
 $('estimate').textContent=numberOrDash(estimate.road_vehicles)+' / '+numberOrDash(estimate.ramp_queue);
 $('forecast').textContent=numberOrDash(command?.forecast_ramp_arrivals_veh)+' veh';
 $('interval').textContent=command?(command.value===0?'Open':numberOrDash(command.value)+' s'):'—';
 const names={unmetered:'Unmetered ramp',fixed_interval:'Fixed schedule',fallback_fixed:'Observation unavailable · fixed fallback',forecast_road_inventory:'Forecast road inventory',ramp_queue_relief:'Predicted ramp queue exceeds threshold'};
 $('decisionReason').textContent=command?names[command.reason]||command.reason:'Waiting';
 const signal=rampSignal(frame);$('execution').textContent=signal.label;$('execution').style.color=signal.color==='#ff665e'?'#b93632':signal.color?'#216b57':'#677671';
 $('executionDetail').textContent=command?'Last release: '+(command.last_release_s===null?'none':numberOrDash(command.last_release_s)+' s')+' · '+command.execution_reason.replaceAll('_',' '):'Simulation has not advanced';
 $('tmcExplanation').textContent='Adaptive policy targets '+cfg.tmc.target_road_vehicles+' road vehicles; release interval '+cfg.tmc.min_release_interval_s+'–'+cfg.tmc.max_release_interval_s+' s. Forecasts actively affect the command. A soft '+cfg.tmc.ramp_queue_threshold_veh+'-vehicle queue threshold requests faster service; it is not a hard storage cap. '+(command?.forecast_road_without_ramp_veh!==null&&command?.forecast_road_without_ramp_veh!==undefined?'Projected road inventory without new ramp entries: '+numberOrDash(command.forecast_road_without_ramp_veh)+' veh. ':'')+'Truth curves are for evaluation only.';
}
function drawTmcPlots(){
 const run=DATA.runs[mode], frames=run.frames;
 for(const [id,key,truth] of [['roadEstimate','road_vehicles',f=>f.vehicles.length],['rampEstimate','ramp_queue',f=>f.ramp_queue]]){
  const max=Math.max(5,...frames.map(f=>Math.max(truth(f),f.estimate[key]||0)));
  const a=axes(id,max*1.1,'Vehicles (veh)');
  line(a,frames.map(f=>[f.time,truth(f)]),'#216b57');line(a,frames.map(f=>[f.time,f.estimate[key]]),'#d98243');cursor(a);
 }
 const rows=run.forecasts.filter(r=>r.segment_id==='ramp_arrivals'&&r.actual_value!==null);
 let a=axes('forecastPlot',Math.max(5,...rows.map(r=>Math.max(r.predicted_value,r.actual_value)))*1.1,'Arrivals in next 30 s (veh)');
 for(const [method,color] of [['moving_average','#7993b0'],['ema','#d98243']])line(a,rows.filter(r=>r.method===method).map(r=>[r.issue_time_s,r.predicted_value]),color);
 line(a,rows.filter(r=>r.method==='ema').map(r=>[r.issue_time_s,r.actual_value]),'#216b57');cursor(a);
 const scores=run.metrics.forecast;
 $('forecastScore').textContent='At forecast issue time: green = subsequently observed arrivals; orange = EMA; blue = moving average. Evaluation starts at '+cfg.tmc.evaluation_start_s+' s. MAE: EMA '+numberOrDash(scores.ema.ramp_arrivals.mae_veh)+' veh; moving average '+numberOrDash(scores.moving_average.ramp_arrivals.mae_veh)+' veh ('+scores.ema.ramp_arrivals.samples+' matched samples).';
 a=axes('meterPlot',cfg.tmc.max_release_interval_s+2,'Release interval (s)');line(a,frames.map(f=>[f.time,f.control?.value]),'#216b57');
 a.c.fillStyle='#d98243';for(const f of frames)if(f.control?.fallback){a.c.beginPath();a.c.arc(a.x(f.time),a.y(f.control.value),2,0,Math.PI*2);a.c.fill();}cursor(a);
}

$('play').onclick=()=>{playing=!playing;if(playing&&index>=endIndex)index=0;last=0;trackUntil=null;$('play').textContent=playing?'Pause':'Play';};$('reset').onclick=()=>{index=0;playing=false;trackedId=null;trackUntil=null;$('play').textContent='Play';update();};$('scrub').oninput=()=>{index=+$('scrub').value;trackUntil=null;update();};$('mode').onchange=()=>{mode=$('mode').value;trackedId=null;trackUntil=null;update();};$('detector').onchange=drawPlots;$('sensorLane').onchange=drawPlots;$('trajectoryLane').onchange=drawPlots;
$('showRamp').onclick=()=>{
 let frames=DATA.runs[mode].frames;
 let target=frames.findIndex(f=>(f.ramp_vehicles||[]).some(v=>v[2]>2));
 if(target<0)target=frames.findIndex(f=>(f.ramp_vehicles||[]).length>0);
 if(target<0){mode='fixed';$('mode').value=mode;frames=DATA.runs[mode].frames;target=frames.findIndex(f=>(f.ramp_vehicles||[]).length>0);}
 index=Math.max(0,target);playing=false;trackedId=null;trackUntil=null;last=0;$('play').textContent='Play';update();
};
$('showMerge').onclick=()=>{if(mode==='open'){mode='closure';$('mode').value=mode;}const events=DATA.runs[mode].merge_events||[];const current=index*cfg.frame_interval_s;const event=events.find(e=>e.time_s>current+3)||events[0];if(!event)return;trackedId=event.vehicle_id;index=Math.max(0,(event.time_s-3)/cfg.frame_interval_s);trackUntil=(event.time_s+4)/cfg.frame_interval_s;$('rate').value='1';playing=true;last=0;$('play').textContent='Pause';update();};
window.onresize=()=>update();function tick(now){if(playing){if(last){index+=(now-last)/1000*+$('rate').value/cfg.frame_interval_s;update(false);if(index>=endIndex||trackUntil!==null&&index>=trackUntil){playing=false;trackUntil=null;$('play').textContent='Play';}}last=now;}else last=0;requestAnimationFrame(tick);}table();update();requestAnimationFrame(tick);
</script></body></html>
